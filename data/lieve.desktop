[Desktop Entry]
Type=Application
Name=Lieve
GenericName=Code Editor
GenericName[it]=Editor di codice
Comment=Lightweight editor with explorer, search and terminal
Comment[it]=Editor leggero con esplora risorse, ricerca e terminale
Exec="@BIN@" %F
TryExec=@BIN@
Icon=lieve
Terminal=false
StartupNotify=true
StartupWMClass=lieve
Categories=Development;TextEditor;IDE;Qt;KDE;
Keywords=editor;code;ide;vscode;
X-Lieve-JumpList=true
Actions=choose;open-folder;

[Desktop Action choose]
Name=Choose Project…
Name[it]=Scegli progetto…
Icon=view-list-details
Exec="@BIN@" --new-window

[Desktop Action open-folder]
Name=Open Folder…
Name[it]=Apri cartella…
Icon=folder-open
Exec="@BIN@" --open-folder
