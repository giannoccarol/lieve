[Desktop Entry]
Type=Application
Name=Lieve
GenericName=Editor di codice
Comment=Editor leggero con esplora risorse, ricerca e terminale
Exec="@BIN@" %F
TryExec=@BIN@
Icon=lieve
Terminal=false
StartupNotify=true
StartupWMClass=lieve
Categories=Development;TextEditor;IDE;Qt;KDE;
Keywords=editor;code;ide;vscode;
X-Lieve-JumpList=true
Actions=choose;open-folder;

[Desktop Action choose]
Name=Scegli progetto…
Icon=view-list-details
Exec="@BIN@" --new-window

[Desktop Action open-folder]
Name=Apri cartella…
Icon=folder-open
Exec="@BIN@" --open-folder
