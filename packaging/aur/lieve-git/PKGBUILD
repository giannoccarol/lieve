# Maintainer: Lorenzo Giannoccaro <93546162+giannoccarol@users.noreply.github.com>
pkgname=lieve-git
pkgver=0.1.1.r0.gf468c5b
pkgrel=1
pkgdesc='Lightweight native code editor for KDE Plasma, with the look and shortcuts of VS Code (development version)'
arch=('x86_64' 'aarch64')
url='https://github.com/giannoccarol/lieve'
license=('GPL-3.0-only')
depends=('qt6-base' 'qt6-svg' 'ktexteditor' 'kparts' 'kxmlgui' 'kcoreaddons' 'kconfig' 'kwidgetsaddons'
         'kdbusaddons' 'kwindowsystem' 'ki18n' 'syntax-highlighting' 'konsole' 'ripgrep' 'git' 'hicolor-icon-theme')
makedepends=('qt6-tools' 'pkgconf')
optdepends=('nodejs: Prettier and ESLint on save, with the project'"'"'s own packages'
            'typescript-language-server: go to definition, errors and completion for TypeScript/JavaScript')
provides=('lieve')
conflicts=('lieve')
source=('git+https://github.com/giannoccarol/lieve.git')
sha256sums=('SKIP')

pkgver() {
  cd lieve
  git describe --long --tags | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

build() {
  cd lieve
  make PREFIX=/usr PACKAGED=1
}

package() {
  cd lieve
  make DESTDIR="$pkgdir" PREFIX=/usr install
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  rm -f "$pkgdir/usr/share/applications/mimeinfo.cache" # left by older Makefiles
}
