# Maintainer: Lorenzo Giannoccaro <93546162+giannoccarol@users.noreply.github.com>
pkgname=lieve
pkgver=0.1.6
pkgrel=1
pkgdesc='Lightweight native code editor for KDE Plasma, with the look and shortcuts of VS Code'
arch=('x86_64' 'aarch64')
url='https://github.com/giannoccarol/lieve'
license=('GPL-3.0-only')
depends=('qt6-base' 'qt6-svg' 'ktexteditor' 'kparts' 'kxmlgui' 'kcoreaddons' 'kconfig' 'kwidgetsaddons'
         'kdbusaddons' 'kwindowsystem' 'ki18n' 'syntax-highlighting' 'breeze-icons' 'ripgrep' 'git' 'hicolor-icon-theme')
makedepends=('qt6-tools' 'pkgconf')
optdepends=('konsole: Konsole as the terminal in the panel (otherwise Lieve'"'"'s built-in one)'
            'nodejs: Prettier and ESLint on save, with the project'"'"'s own packages'
            'typescript-language-server: go to definition, errors and completion for TypeScript/JavaScript')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('aad66d95f8a7388d0dfeb0662d022a1620dcdbc05ec2f155a9420f35700e5b83')

build() {
  cd "$pkgname-$pkgver"
  make PREFIX=/usr PACKAGED=1
}

package() {
  cd "$pkgname-$pkgver"
  make DESTDIR="$pkgdir" PREFIX=/usr install
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  rm -f "$pkgdir/usr/share/applications/mimeinfo.cache" # left by older Makefiles
}
